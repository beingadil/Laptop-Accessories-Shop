{
  "name": "tayyab-enterprises-management-system",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "clean": "next clean",
    "postinstall": "prisma generate",
    "test": "node --test --import ./tests/register-aliases.mjs lib/domain/calculations.test.ts lib/date-utils.test.ts lib/branding.test.ts tests/unit/auth-edge.test.ts tests/integration/sales.integration.test.ts",
    "test:watch": "node --test --watch --import ./tests/register-aliases.mjs lib/domain/calculations.test.ts tests/unit/auth-edge.test.ts tests/integration/sales.integration.test.ts",
    "ci": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "electron:dev": "ELECTRON_DEV=1 electron .",
    "electron:start": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win --config electron-builder.json"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.1",
    "@prisma/client": "^6.16.0",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.12",
    "@types/bcryptjs": "^2.4.6",
    "autoprefixer": "^10.4.21",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.11",
    "exceljs": "^4.4.0",
    "jose": "^6.0.10",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.4",
    "lucide-react": "^0.553.0",
    "next": "^15.4.9",
    "postcss": "^8.5.6",
    "prisma": "^6.16.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "recharts": "^2.15.3",
    "sonner": "^2.0.3",
    "tailwind-merge": "^3.3.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.11",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "eslint": "9.39.1",
    "eslint-config-next": "16.0.8",
    "tailwindcss": "4.1.11",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3"
  }
}
