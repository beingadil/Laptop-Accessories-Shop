{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.laptopmanagement.app",
  "productName": "Laptop Management System",
  "artifactName": "Laptop-Management-System-Setup-${version}.${ext}",
  "icon": "build/icon.ico",
  "directories": {
    "output": "dist-electron"
  },
  "files": [
    "electron/**/*"
  ],
  "extraResources": [
    {
      "from": ".next/standalone",
      "to": "standalone",
      "filter": ["**/*", "!.env"]
    },
    {
      "from": ".next/standalone/node_modules",
      "to": "standalone/node_modules",
      "filter": ["**/*"]
    },
    {
      "from": ".next/static",
      "to": "standalone/.next/static",
      "filter": ["**/*"]
    },
    {
      "from": "public",
      "to": "standalone/public",
      "filter": ["**/*"]
    },
    {
      "from": "prisma/dev.db",
      "to": "prisma/dev.db"
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "icon": "build/icon.ico"
  },
  "publish": [
    {
      "provider": "github",
      "owner": "beingadil",
      "repo": "Laptop-Accessories-Shop",
      "releaseType": "release"
    }
  ],
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Laptop Management System"
  }
}
