generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum InventoryType {
  SERIALIZED
  QUANTITY
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum ItemCondition {
  NEW
  USED
  REFURBISHED
}

enum SerializedStockStatus {
  IN_STOCK
  SOLD
  RETURNED_DEFECTIVE
  DAMAGED
  LOST
}

enum StockMovementType {
  OPENING_STOCK
  PURCHASE
  SALE
  SALE_RETURN
  PURCHASE_RETURN
  EXCHANGE_IN
  EXCHANGE_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  DAMAGED
  LOST
  REVERSAL
}

enum TransactionStatus {
  COMPLETED
  CANCELLED
}

enum SaleStatus {
  COMPLETED
  PARTIAL_RETURN
  RETURNED
  CANCELLED
}

enum ReturnType {
  RETURN
  EXCHANGE
}

enum ReturnReason {
  DEFECTIVE
  CHANGED_MIND
  WRONG_PRODUCT
  OTHER
}

enum RestockStatus {
  RESTOCKED
  DAMAGED
}

enum WarrantyStatus {
  ACTIVE
  EXPIRED
  VOID
}

model AdminUser {
  id           String     @id @default(cuid())
  username     String     @unique
  displayName  String     @default("Tayyab Admin")
  passwordHash String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  auditLogs    AuditLog[]
}

model ShopSettings {
  id                    String   @id @default("default")
  shopName              String   @default("Tayyab Enterprises")
  address               String   @default("Muneer Chowk, Shop No. 152")
  phone1                String   @default("03126482836")
  phone2                String   @default("03298304862")
  logoDataUrl           String?
  invoicePrefix         String   @default("TE-INV-")
  purchasePrefix        String   @default("TE-PUR-")
  invoiceFooter         String   @default("Thank you for choosing Tayyab Enterprises. Please keep this invoice for warranty claims.")
  warrantyTerms         String   @default("Standard checking warranty applies as specified per item. Physical damage, burn marks, liquid spill, or tampered seals void warranty.")
  showWarrantyOnInvoice Boolean  @default(true)
  defaultMinStock       Int      @default(3)
  lowStockAlertsEnabled Boolean  @default(true)
  backupDirectory       String   @default("")
  updatedAt             DateTime @updatedAt
}

model ProductCategory {
  id                   String        @id @default(cuid())
  name                 String        @unique
  description          String?
  defaultInventoryType InventoryType @default(QUANTITY)
  status               RecordStatus  @default(ACTIVE)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  products             Product[]

  @@index([status])
  @@index([name])
}

model Product {
  id               String                    @id @default(cuid())
  name             String
  sku              String                    @unique
  categoryId       String
  category         ProductCategory           @relation(fields: [categoryId], references: [id])
  brand            String
  model            String
  processor        String?
  ram              String?
  ssd              String?
  hdd              String?
  storage          String?
  screenSize       String?
  condition        ItemCondition             @default(NEW)
  description      String?
  purchasePrice    Float                     @default(0)
  sellingPrice     Float                     @default(0)
  minimumStock     Int                       @default(3)
  currentStock     Int                       @default(0)
  inventoryType    InventoryType             @default(QUANTITY)
  status           RecordStatus              @default(ACTIVE)
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  serializedItems  SerializedInventoryItem[]
  stockMovements   StockMovement[]
  purchaseItems    PurchaseItem[]
  saleItems        SaleItem[]
  returnItems      ReturnItem[]
  exchangeOutItems ExchangeReplacementItem[]
  warranties       Warranty[]

  @@index([name])
  @@index([sku])
  @@index([categoryId])
  @@index([status])
  @@index([inventoryType])
  @@index([currentStock])
}

model SerializedInventoryItem {
  id               String                    @id @default(cuid())
  productId        String
  product          Product                   @relation(fields: [productId], references: [id])
  serialNumber     String                    @unique
  purchasePrice    Float
  sellingPrice     Float
  condition        ItemCondition             @default(USED)
  purchaseId       String?
  purchase         Purchase?                 @relation(fields: [purchaseId], references: [id])
  stockStatus      SerializedStockStatus     @default(IN_STOCK)
  notes            String?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  stockMovements   StockMovement[]
  saleItems        SaleItem[]
  returnItems      ReturnItem[]
  exchangeOutItems ExchangeReplacementItem[]
  warranties       Warranty[]

  @@index([serialNumber])
  @@index([productId, stockStatus])
  @@index([purchaseId])
  @@index([stockStatus])
}

model StockMovement {
  id               String                   @id @default(cuid())
  productId        String
  product          Product                  @relation(fields: [productId], references: [id])
  serializedItemId String?
  serializedItem   SerializedInventoryItem? @relation(fields: [serializedItemId], references: [id])
  movementType     StockMovementType
  quantity         Int
  referenceType    String
  referenceId      String?
  previousStock    Int
  newStock         Int
  reason           String?
  createdAt        DateTime                 @default(now())

  @@index([productId, createdAt])
  @@index([movementType])
  @@index([referenceType, referenceId])
  @@index([createdAt])
}

model Customer {
  id        String     @id @default(cuid())
  name      String
  phone     String
  address   String?
  notes     String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  sales     Sale[]
  returns   Return[]
  warranties Warranty[]

  @@index([name])
  @@index([phone])
}

model Supplier {
  id                 String            @id @default(cuid())
  name               String
  phone              String
  address            String?
  notes              String?
  openingBalance     Float             @default(0)
  outstandingBalance Float             @default(0)
  status             RecordStatus      @default(ACTIVE)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  purchases          Purchase[]
  payments           SupplierPayment[]

  @@index([name])
  @@index([phone])
  @@index([status])
}

model Purchase {
  id                String                    @id @default(cuid())
  purchaseNumber    String                    @unique
  supplierId        String
  supplier          Supplier                  @relation(fields: [supplierId], references: [id])
  purchaseDate      DateTime                  @default(now())
  totalAmount       Float
  paidAmount        Float                     @default(0)
  outstandingAmount Float                     @default(0)
  notes             String?
  status            TransactionStatus         @default(COMPLETED)
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  items             PurchaseItem[]
  serializedItems   SerializedInventoryItem[]

  @@index([purchaseNumber])
  @@index([supplierId])
  @@index([purchaseDate])
  @@index([status])
}

model PurchaseItem {
  id            String         @id @default(cuid())
  purchaseId    String
  purchase      Purchase       @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId     String
  product       Product        @relation(fields: [productId], references: [id])
  quantity      Int
  unitCost      Float
  totalCost     Float
  condition     ItemCondition?
  serialNumbers String?

  @@index([purchaseId])
  @@index([productId])
}

model SupplierPayment {
  id              String            @id @default(cuid())
  supplierId      String
  supplier        Supplier          @relation(fields: [supplierId], references: [id])
  paymentDate     DateTime          @default(now())
  amount          Float
  paymentMethod   String            @default("CASH")
  referenceNumber String?
  notes           String?
  status          TransactionStatus @default(COMPLETED)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([supplierId])
  @@index([paymentDate])
  @@index([status])
}

model Sale {
  id                 String     @id @default(cuid())
  invoiceNumber      String     @unique
  customerId         String?
  customer           Customer?  @relation(fields: [customerId], references: [id])
  walkInCustomerName String?
  walkInCustomerPhone String?
  saleDate           DateTime   @default(now())
  subtotal           Float
  discount           Float      @default(0)
  totalAmount        Float
  totalCost          Float      @default(0)
  grossProfit        Float      @default(0)
  paymentMethod      String     @default("CASH")
  status             SaleStatus @default(COMPLETED)
  notes              String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  items              SaleItem[]
  returns            Return[]
  warranties         Warranty[]

  @@index([invoiceNumber])
  @@index([customerId])
  @@index([saleDate])
  @@index([status])
}

model SaleItem {
  id               String                   @id @default(cuid())
  saleId           String
  sale             Sale                     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId        String
  product          Product                  @relation(fields: [productId], references: [id])
  serializedItemId String?
  serializedItem   SerializedInventoryItem? @relation(fields: [serializedItemId], references: [id])
  quantity         Int
  returnedQuantity Int                      @default(0)
  unitPrice        Float
  unitCost         Float
  discount         Float                    @default(0)
  totalAmount      Float
  warrantyMonths   Int                      @default(0)
  returnItems      ReturnItem[]
  warranties       Warranty[]

  @@index([saleId])
  @@index([productId])
  @@index([serializedItemId])
}

model ExpenseCategory {
  id        String       @id @default(cuid())
  name      String       @unique
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  expenses  Expense[]

  @@index([status])
}

model Expense {
  id          String          @id @default(cuid())
  title       String
  categoryId  String
  category    ExpenseCategory @relation(fields: [categoryId], references: [id])
  amount      Float
  expenseDate DateTime        @default(now())
  description String?
  notes       String?
  status      RecordStatus    @default(ACTIVE)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([categoryId])
  @@index([expenseDate])
  @@index([status])
}

model Return {
  id               String                    @id @default(cuid())
  returnNumber     String                    @unique
  originalSaleId   String
  originalSale     Sale                      @relation(fields: [originalSaleId], references: [id])
  customerId       String?
  customer         Customer?                 @relation(fields: [customerId], references: [id])
  returnDate       DateTime                  @default(now())
  type             ReturnType                @default(RETURN)
  reason           ReturnReason              @default(DEFECTIVE)
  refundAmount     Float                     @default(0)
  priceDifference  Float                     @default(0)
  profitAdjustment Float                     @default(0)
  notes            String?
  createdAt        DateTime                  @default(now())
  items            ReturnItem[]
  replacementItems ExchangeReplacementItem[]

  @@index([returnNumber])
  @@index([originalSaleId])
  @@index([returnDate])
  @@index([type])
}

model ReturnItem {
  id               String                   @id @default(cuid())
  returnId         String
  returnRecord     Return                   @relation(fields: [returnId], references: [id], onDelete: Cascade)
  saleItemId       String
  saleItem         SaleItem                 @relation(fields: [saleItemId], references: [id])
  productId        String
  product          Product                  @relation(fields: [productId], references: [id])
  serializedItemId String?
  serializedItem   SerializedInventoryItem? @relation(fields: [serializedItemId], references: [id])
  quantity         Int
  restockStatus    RestockStatus            @default(RESTOCKED)
  condition        String?
  refundAmount     Float
  costAmount       Float

  @@index([returnId])
  @@index([saleItemId])
  @@index([productId])
}

model ExchangeReplacementItem {
  id               String                   @id @default(cuid())
  returnId         String
  returnRecord     Return                   @relation(fields: [returnId], references: [id], onDelete: Cascade)
  productId        String
  product          Product                  @relation(fields: [productId], references: [id])
  serializedItemId String?
  serializedItem   SerializedInventoryItem? @relation(fields: [serializedItemId], references: [id])
  quantity         Int
  unitPrice        Float
  unitCost         Float
  totalAmount      Float

  @@index([returnId])
  @@index([productId])
}

model Warranty {
  id               String                   @id @default(cuid())
  saleId           String
  sale             Sale                     @relation(fields: [saleId], references: [id])
  saleItemId       String
  saleItem         SaleItem                 @relation(fields: [saleItemId], references: [id])
  customerId       String?
  customer         Customer?                @relation(fields: [customerId], references: [id])
  productId        String
  product          Product                  @relation(fields: [productId], references: [id])
  serializedItemId String?
  serializedItem   SerializedInventoryItem? @relation(fields: [serializedItemId], references: [id])
  warrantyStart    DateTime
  warrantyEnd      DateTime
  durationMonths   Int
  warrantyTerms    String?
  status           WarrantyStatus           @default(ACTIVE)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  @@index([saleId])
  @@index([warrantyEnd])
  @@index([status])
  @@index([serializedItemId])
}

model AuditLog {
  id           String     @id @default(cuid())
  entityType   String
  entityId     String
  action       String
  previousData String?
  updatedData  String?
  adminUserId  String?
  adminUser    AdminUser? @relation(fields: [adminUserId], references: [id])
  createdAt    DateTime   @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}
