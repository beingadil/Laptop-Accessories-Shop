# This application runs fully offline on your desktop.
# No external API keys are required or used.

# DATABASE_URL: SQLite database file path for Prisma.
# Relative to the prisma/ directory by default (prisma/dev.db).
# In the packaged desktop app this is overridden automatically
# (Electron sets it to the persistent userData location).
DATABASE_URL="file:./dev.db"

# AUTH_SECRET: Secret key for signing admin session tokens.
# Generate a unique value for each deployment, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# APP_URL: Base URL of the app (used only for web/dev deployments).
# Not required for the desktop application.
APP_URL=""
